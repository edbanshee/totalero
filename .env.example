# Public Firebase web configuration; never place service-account keys here.
# Copy to .env.local (already excluded from the repository).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Only used by build:pages; GitHub Actions calculates it from owner/repository.
VITE_BASE_PATH=/totalero/